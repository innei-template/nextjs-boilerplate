{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "scripts": {
    "analyze": "cross-env NODE_ENV=production ANALYZE=true BUNDLE_ANALYZE=browser next build",
    "build": "cross-env NODE_ENV=production next build",
    "build:ci": "cross-env NODE_ENV=production CI=true next build",
    "dev": "cross-env NODE_ENV=development next dev --turbopack -p 4399",
    "lint": "eslint --cache --fix",
    "prebuild": "rimraf .next || exit 0",
    "prepare": "pnpm exec simple-git-hooks && test -f .env || cp .env.template .env",
    "start": "npm run dev"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.6",
    "@tanstack/query-async-storage-persister": "5.90.1",
    "@tanstack/react-query": "5.90.1",
    "@tanstack/react-query-persist-client": "5.90.1",
    "@types/js-cookie": "3.0.6",
    "axios": "1.12.2",
    "clsx": "2.1.1",
    "dayjs": "1.11.18",
    "es-toolkit": "1.39.10",
    "foxact": "0.2.49",
    "idb-keyval": "6.2.2",
    "immer": "10.1.3",
    "jojoo": "0.3.0",
    "jotai": "2.14.0",
    "js-cookie": "3.0.7",
    "motion": "12.23.18",
    "next": "15.5.3",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-error-boundary": "6.0.0",
    "react-intersection-observer": "9.16.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "usehooks-ts": "3.1.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "1.9.0",
    "@iconify-json/lucide": "1.2.68",
    "@iconify-json/mingcute": "1.2.5",
    "@iconify-json/simple-icons": "1.2.53",
    "@iconify/tailwind": "1.2.0",
    "@innei/prettier": "1.0.0",
    "@next/bundle-analyzer": "15.5.3",
    "@pastel-palette/tailwindcss": "1.0.0-canary.3",
    "@tailwindcss/postcss": "4.1.13",
    "@tailwindcss/typography": "0.5.18",
    "@tanstack/react-query-devtools": "5.90.1",
    "@types/node": "24.5.2",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1",
    "autoprefixer": "10.4.21",
    "code-inspector-plugin": "1.2.10",
    "cross-env": "10.0.0",
    "dotenv": "17.2.2",
    "eslint": "9.36.0",
    "eslint-config-hyoban": "4.0.10",
    "husky": "9.1.7",
    "lint-staged": "16.2.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "simple-git-hooks": "2.13.1",
    "tailwind-scrollbar": "4.0.2",
    "tailwind-variants": "3.1.1",
    "tailwindcss": "^4.1.13",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-safe-area": "1.1.0",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "array-includes": "npm:@nolyfill/array-includes@latest",
      "array.prototype.findlastindex": "npm:@nolyfill/array.prototype.findlastindex@latest",
      "array.prototype.flat": "npm:@nolyfill/array.prototype.flat@latest",
      "array.prototype.flatmap": "npm:@nolyfill/array.prototype.flatmap@latest",
      "array.prototype.tosorted": "npm:@nolyfill/array.prototype.tosorted@latest",
      "has": "npm:@nolyfill/has@latest",
      "object.assign": "npm:@nolyfill/object.assign@latest",
      "object.entries": "npm:@nolyfill/object.entries@latest",
      "object.fromentries": "npm:@nolyfill/object.fromentries@latest",
      "object.groupby": "npm:@nolyfill/object.groupby@latest",
      "object.hasown": "npm:@nolyfill/object.hasown@latest",
      "object.values": "npm:@nolyfill/object.values@latest",
      "string.prototype.matchall": "npm:@nolyfill/string.prototype.matchall@latest",
      "@types/react": "npm:types-react@19.0.0-rc.1",
      "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --ignore-path ./.gitignore --write "
    ]
  },
  "bump": {
    "before": [
      "git pull --rebase",
      "ni"
    ],
    "changelog": true
  }
}